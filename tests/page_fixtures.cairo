    assert(page_data::ENGINE_SHA256 == ENGINE_SHA256, 'engine sha256');
    assert(page_data::GZIP_SHA256 == GZIP_SHA256, 'gzip sha256');
    assert_eq!(page_data::GZIP_LEN, GZIP_LEN);
}

