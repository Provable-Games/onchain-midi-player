#[test]
fn case_every_slot_settings_encode_as_in_the_fixture() {
    let settings = case_every_slot_settings();
    validate(@settings);
    assert_eq!(encode(@settings), case_every_slot_settings_text());
}

#[test]
fn case_every_slot_midi_segment_matches_the_fixture() {
    let settings = case_every_slot_settings();
    let got = segment::midi_segment(case_every_slot_midi(), @settings);
    assert(got == case_every_slot_midi_segment(), 'midi_segment != fixture');
}

#[test]
fn case_every_slot_library_call_matches_the_fixture() {
    let settings = case_every_slot_settings();
    let got = class().midi_segment(case_every_slot_midi(), settings);
    assert(got == case_every_slot_midi_segment(), 'midi_segment != fixture');
}

#[test]
fn case_every_slot_html_and_token_uri_match_the_digests() {
    let midi = case_every_slot_midi();
    let settings = case_every_slot_settings();
    let svg = case_every_slot_svg();
    let mut html = class_fixtures::page();
    html.append(@segment::d_fragment(midi.clone(), @settings));
    html.append(@svg);
    let html_digest = (html.len(), sha256(@html));
    assert(html_digest == case_every_slot_animation_html_digest(), 'html != digest');
    let uri = beasts_token_uri(@case_every_slot_members(), @svg, midi, @settings);
    let uri_digest = (uri.len(), sha256(@uri));
    assert(uri_digest == case_every_slot_token_uri_digest(), 'token_uri != digest');
}

/// The MIDI of the invalid cases (midi_segment reverts before it is used).
pub fn invalid_midi() -> ByteArray {
    let mut felts = INVALID_MIDI.span();
    let value = Serde::deserialize(ref felts).expect('fixture: bad Serde');
    assert(felts.len() == 0, 'fixture: trailing felts');
    value
