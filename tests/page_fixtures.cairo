/// The panic data midi_segment must revert with.
pub fn invalid_timbres_176_error() -> Array<felt252> {
    array!['TS: too many timbres']
}

#[test]
#[should_panic(expected: 'TS: too many timbres')]
fn invalid_timbres_176_settings_revert() {
    let settings = invalid_timbres_176_settings();
    validate(@settings);
    let _text = encode(@settings);
}

#[test]
#[should_panic(expected: 'TS: too many timbres')]
fn invalid_timbres_176_midi_segment_reverts() {
    let _segment = segment::midi_segment(invalid_midi(), @invalid_timbres_176_settings());
}

// Through the library call, the panic data arrives whole, followed by 'ENTRYPOINT_FAILED'.
#[test]
#[feature("safe_dispatcher")]
fn invalid_timbres_176_library_call_reverts_with_the_panic_data() {
    match safe_class().midi_segment(invalid_midi(), invalid_timbres_176_settings()) {
        Result::Ok(_) => panic!("midi_segment should revert"),
        Result::Err(panic_data) => {
            let mut expected = invalid_timbres_176_error();
            expected.append('ENTRYPOINT_FAILED');
            assert_eq!(panic_data, expected);
        },
    }
}
