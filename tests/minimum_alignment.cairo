//! Test-only minimum-padding provider; artifacts generated by pinned toolchain.
#[starknet::contract]
pub mod MinimumAlignedTinySynth {
    use onchain_midi_player::interface::ITinySynth;
    use onchain_midi_player::types::TinySynthSettings;
    #[storage]
    struct Storage {}
    #[abi(embed_v0)]
    impl Provider of ITinySynth<ContractState> {
        fn gunzip_segment(self: @ContractState) -> ByteArray {
            ""
        }
        fn engine_segment(self: @ContractState) -> ByteArray {
            ""
        }
        fn player_segment(self: @ContractState) -> ByteArray {
            ""
        }
        fn midi_segment(
            self: @ContractState, midi: ByteArray, settings: TinySynthSettings,
        ) -> ByteArray {
            onchain_midi_player::segment::midi_segment(midi, @settings)
        }
        fn engine(self: @ContractState) -> felt252 {
            'tinysynth'
        }
        fn version(self: @ContractState) -> felt252 {
            '0.5.0'
        }
        fn script_sha256(self: @ContractState) -> u256 {
            onchain_midi_player::segment_data::ENGINE_SHA256
        }
        fn license(self: @ContractState) -> ByteArray {
            onchain_midi_player::segment_data::license()
        }
    }
}
