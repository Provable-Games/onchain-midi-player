#[test]
fn data_parity_all_lengths_and_word_residues() {
    let expected = data_length_vectors();
    let mut midi: ByteArray = "";
    let mut n = 0;
    while n != 101 {
        assert_eq!(
            segment::midi_segment(midi.clone(), @case_default_120bpm_settings()),
            expected[n].clone(),
        );
        midi.append_byte(0x90);
        n += 1;
    }
}
